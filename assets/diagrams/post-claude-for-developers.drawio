<mxfile host="drawio">
  <diagram id="design-review" name="design-review">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lI" value="What I give the model" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="lM" value="What I ask it to do" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="440" height="300" as="geometry"/></mxCell>
        <mxCell id="lO" value="What stays with people" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="800" y="40" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;Context, written down&lt;/b&gt;&lt;br&gt;requirements, constraints,&lt;br&gt;current design, the options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="out" value="&lt;b&gt;Never in the prompt&lt;/b&gt;&lt;br&gt;secrets, customer data,&lt;br&gt;PHI, real hostnames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D4A72C;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="challenge" value="&lt;b&gt;Challenge the design&lt;/b&gt;&lt;br&gt;argue against my choice; list failure modes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="85" width="400" height="55" as="geometry"/></mxCell>
        <mxCell id="draft" value="&lt;b&gt;Draft the boring parts&lt;/b&gt;&lt;br&gt;ADR, threat model table, runbook skeleton" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="155" width="400" height="55" as="geometry"/></mxCell>
        <mxCell id="check" value="&lt;b&gt;Check my reasoning&lt;/b&gt;&lt;br&gt;what did I assume? what would change the answer?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="225" width="400" height="55" as="geometry"/></mxCell>
        <mxCell id="decide" value="&lt;b&gt;The decision&lt;/b&gt;&lt;br&gt;and who signs it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="85" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="verify" value="&lt;b&gt;Verification&lt;/b&gt;&lt;br&gt;docs, a test, a prototype, a peer review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="155" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="own" value="&lt;b&gt;Accountability&lt;/b&gt;&lt;br&gt;&quot;the AI suggested it&quot; is not a reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="225" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ctx" target="challenge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="challenge" target="decide"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="draft" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="check" target="own"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>

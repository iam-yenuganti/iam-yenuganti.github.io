<mxfile host="drawio">
  <diagram id="wif" name="GitHub OIDC to Azure">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Lanes -->
        <mxCell id="laneGitHub" value="GitHub" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="340" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="laneEntra" value="Microsoft Entra ID" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="390" y="40" width="340" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="laneAzure" value="Azure · production subscription" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="380" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="laneEvidence" value="Evidence for every deployment" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#D6D6D6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="495" width="1120" height="150" as="geometry"/>
        </mxCell>

        <!-- GitHub -->
        <mxCell id="pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;reviewed and merged to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="85" width="290" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Environment protection rules&lt;/b&gt;&lt;br&gt;required reviewers · main branch only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D4A72C;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="180" width="290" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Deploy job&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;environment: production&lt;br&gt;permissions: id-token: write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="275" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="issuer" value="&lt;b&gt;GitHub OIDC token issuer&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;token.actions.githubusercontent.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="385" width="290" height="60" as="geometry"/>
        </mxCell>

        <!-- Entra -->
        <mxCell id="entraIcon" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/other/Entra_Identity.svg;" vertex="1" parent="1">
          <mxGeometry x="526" y="75" width="68" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fic" value="&lt;b&gt;Federated identity credential&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;iss: token.actions.githubusercontent.com&lt;br&gt;sub: repo:org/app:environment:production&lt;br&gt;aud: api://AzureADTokenExchange&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="405" y="165" width="310" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="uami" value="&lt;b&gt;id-deploy-prod&lt;/b&gt;&lt;br&gt;user-assigned managed identity&lt;br&gt;one per environment, no secrets" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/identity/Managed_Identities.svg;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#F2F8FD;" vertex="1" parent="1">
          <mxGeometry x="526" y="310" width="68" height="66" as="geometry"/>
        </mxCell>

        <!-- Azure -->
        <mxCell id="rg" value="rg-app-prod" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="85" width="340" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="App Service" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="798" y="130" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="kv" value="Key Vault" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="sql" value="Azure SQL" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1">
          <mxGeometry x="968" y="125" width="45" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="st" value="Storage" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
          <mxGeometry x="1040" y="135" width="60" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rbac" value="&lt;b&gt;Azure RBAC role assignment&lt;/b&gt;&lt;br&gt;Contributor, scoped to rg-app-prod only&lt;br&gt;nothing at subscription scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="340" height="66" as="geometry"/>
        </mxCell>

        <!-- Evidence -->
        <mxCell id="evGh" value="&lt;b&gt;GitHub deployment history and audit log&lt;/b&gt;&lt;br&gt;who triggered, who approved, run ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="545" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="evEntra" value="&lt;b&gt;Entra sign-in logs&lt;/b&gt;&lt;br&gt;managed identity sign-ins: token issued, credential used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="405" y="545" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="evAct" value="&lt;b&gt;Azure Activity Log&lt;/b&gt;&lt;br&gt;what changed, by which identity, when" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="545" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- Flow edges -->
        <mxCell id="e1" value="1  merge triggers the workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F6F8FA;" edge="1" parent="1" source="pr" target="gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2  reviewer approves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F6F8FA;" edge="1" parent="1" source="gate" target="job">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3  request OIDC token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F6F8FA;" edge="1" parent="1" source="job" target="issuer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="4  signed JWT&lt;br&gt;sent to Entra" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="issuer" target="fic">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="375" y="415"/>
              <mxPoint x="375" y="212"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="5  claims match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F2F8FD;" edge="1" parent="1" source="fic" target="uami">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="6  access token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uami" target="rbac">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="343"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="7  deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F2F8FD;" edge="1" parent="1" source="rbac" target="rg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Evidence edges -->
        <mxCell id="l1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C959F;dashed=1;endArrow=open;fontSize=10;" edge="1" parent="1" source="issuer" target="evGh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C959F;dashed=1;endArrow=open;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uami" target="evEntra">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="436" y="343"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C959F;dashed=1;endArrow=open;fontSize=10;" edge="1" parent="1" source="rbac" target="evAct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

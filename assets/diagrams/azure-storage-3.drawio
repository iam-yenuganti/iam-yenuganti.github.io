<mxfile host="drawio">
  <diagram id="dr" name="Multi-region DR">
    <mxGraphModel dx="1100" dy="560" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="fd" value="Azure Front Door&lt;br&gt;priority routing + health probes" style="image;aspect=fixed;html=1;points=[];align=left;fontSize=12;image=img/lib/azure2/networking/Front_Doors.svg;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="68" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pri" value="Primary region" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#9CC3E6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="420" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="secr" value="Secondary (paired) region" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F1FA;strokeColor=#C9B3DD;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#1F2328;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="420" height="370" as="geometry"/>
        </mxCell>

        <mxCell id="app1" value="App Service&lt;br&gt;(active)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="198" y="175" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="st1" value="Storage account&lt;br&gt;RA-GZRS (primary)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
          <mxGeometry x="200" y="300" width="60" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sql1" value="Azure SQL&lt;br&gt;failover group primary" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1">
          <mxGeometry x="207" y="400" width="45" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="app2" value="App Service&lt;br&gt;(deployed by IaC, standby)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="738" y="175" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="st2" value="Storage secondary&lt;br&gt;read-only until failover" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="60" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="sql2" value="Azure SQL&lt;br&gt;geo-secondary" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1">
          <mxGeometry x="747" y="400" width="45" height="60" as="geometry"/>

        <mxCell id="st" value="Static site in Storage&lt;br&gt;(private endpoint)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/storage/Storage_Accounts.svg;labelBackgroundColor=#F2F8FD;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1">
          <mxGeometry x="1030" y="144" width="60" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="e2eNote" value="HTTPS to every backend (end-to-end TLS).&lt;br&gt;Backends accept traffic only from the gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="290" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="kv" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;TLS certificate, auto-renewed,&lt;br&gt;read by the gateway's managed identity" style="image;aspect=fixed;html=1;points=[];align=left;fontSize=12;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="law" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;AGWFirewallLogs, AGWAccessLogs&lt;br&gt;log scrubbing for sensitive fields" style="image;aspect=fixed;html=1;points=[];align=left;fontSize=12;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="506" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="sentinel" value="&lt;b&gt;Microsoft Sentinel&lt;/b&gt;&lt;br&gt;block spikes, new rule hits,&lt;br&gt;correlation with sign-ins" style="image;aspect=fixed;html=1;points=[];align=left;fontSize=12;image=img/lib/azure2/security/Azure_Sentinel.svg;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="504" width="56" height="68" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="agw">
          <mxGeometry relative="1" as="geometry"/>

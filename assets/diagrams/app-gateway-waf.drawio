        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="e2eNote" target="st">

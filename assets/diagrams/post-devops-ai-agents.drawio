<mxfile host="drawio">
  <diagram id="ops-agents" name="ops-agents">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lS" value="Signal" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#D6D6D6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="200" height="290" as="geometry"/></mxCell>
        <mxCell id="lA" value="Agent does the legwork" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="380" height="290" as="geometry"/></mxCell>
        <mxCell id="lG" value="Human gate" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="200" height="290" as="geometry"/></mxCell>
        <mxCell id="lX" value="Change happens" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#C7DDF2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="300" height="290" as="geometry"/></mxCell>
        <mxCell id="alert" value="&lt;b&gt;Azure Monitor alert&lt;/b&gt;&lt;br&gt;or incident ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="alert_i0" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/management_governance/Alerts.svg;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="104.0" y="95" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="issue" value="&lt;b&gt;Issue or failed&lt;br&gt;pipeline run&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="sre" value="&lt;b&gt;Azure SRE Agent&lt;/b&gt;&lt;br&gt;reads metrics, logs and recent&lt;br&gt;deployments; proposes a fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;align=left;spacingLeft=56;" vertex="1" parent="1"><mxGeometry x="260" y="85" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="sre_i0" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/management_governance/Monitor.svg;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="270" y="112.0" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="coding" value="&lt;b&gt;Coding agent&lt;/b&gt;&lt;br&gt;reproduces the failure and opens&lt;br&gt;a pull request with the fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="215" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="review" value="&lt;b&gt;Review mode&lt;/b&gt;&lt;br&gt;an SRE Agent admin&lt;br&gt;approves the write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D4A72C;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="85" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="pr" value="&lt;b&gt;Pull request review&lt;/b&gt;&lt;br&gt;branch protection,&lt;br&gt;required reviewers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D4A72C;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="215" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="act" value="&lt;b&gt;Agent&#x27;s managed identity&lt;/b&gt;&lt;br&gt;RBAC scoped to one&lt;br&gt;resource group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;align=left;spacingLeft=56;" vertex="1" parent="1"><mxGeometry x="875" y="85" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="act_i0" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Managed_Identities.svg;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="885" y="112.0" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="pipe" value="&lt;b&gt;Normal pipeline&lt;/b&gt;&lt;br&gt;plan, approval, deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875" y="215" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="note" value="Read-only questions (what changed? why is it slow?) run without approval. Writes go through a gate until a specific, repeated fix has earned Autonomous mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6D6D6;fontSize=12;fillColor=#F7F7F7;fontColor=#3D444D;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1140" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="alert" target="sre"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#24292F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="issue" target="coding"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="proposed action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F2F8FD;" edge="1" parent="1" source="sre" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="review" target="act"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="pull request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F2F8FD;" edge="1" parent="1" source="coding" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0078D4;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pr" target="pipe"><mxGeometry relative="1" as="geometry"/></mxCell>
